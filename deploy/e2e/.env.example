# Local E2E environment — copy to .env and fill in real values
# cp .env.example .env

# Path to the fs9 repository on your machine
FS9_REPO_PATH=/Users/yourname/fs9

# Secrets shared between fs9-meta and fs9-server (must match)
# Generate with: openssl rand -hex 32
FS9_JWT_SECRET=change-me-use-a-strong-random-secret-at-least-32-chars
FS9_META_KEY=admin-key-change-me-use-random-string

# PostgreSQL credentials (used by pgtikv-admin backend)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Optional: API key(s) for pgtikv-admin (comma-separated; empty = no key required)
PGTIKV_API_KEYS=

# Log level for all Rust services (info | debug | trace)
RUST_LOG=info
