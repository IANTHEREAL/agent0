# RLS EXPLAIN assertions — all positive (presence) checks
# Absence-of-filter bypass cases are covered by rls_select.sql

# Q1: Default-deny (no policies, RLS enabled) — injects WHERE false
Filter: false

# Q2: Permissive policy — shows owner = current_user predicate
owner = 'rls_exp_user'::text

# Q3: Actual results — only own rows visible
rls_exp_user|visible
rls_exp_user|also visible

# Q4: Restrictive + permissive — both predicates appear with AND
(id > 1)

# Q5: Restrictive narrows results — only id=3 visible
3|rls_exp_user|also visible

# Q6: User WHERE clause coexists with RLS filter
(data = 'visible'::text)
owner = 'rls_exp_user'::text
