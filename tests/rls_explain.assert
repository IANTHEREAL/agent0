# RLS EXPLAIN assertions against PostgreSQL 17 after ANALYZE stabilizes
# plan selection for this tiny table.

# Q1: Default-deny
One-Time Filter: false

# Q2: Permissive policy
Filter: (owner = CURRENT_USER)

# Q3: Permissive results
q3:1,3

# Q4: Restrictive + permissive
Filter: ((id > 1) AND (owner = CURRENT_USER))

# Q5: Restrictive narrows results
q5:3

# Q6: User WHERE coexists with RLS
Filter: ((id > 1) AND (data = 'visible'::text) AND (owner = CURRENT_USER))
