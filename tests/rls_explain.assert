# RLS EXPLAIN assertions — each line is globally unique in the test output
# so substring matching validates per-query behavior.

# Q1: Default-deny (no policies) — only this query produces "Filter: false"
Filter: false

# Q2: Permissive policy — unique because Q4/Q6 produce longer Filter lines
Filter: (owner = 'rls_exp_user'::text)

# Q3: Permissive results — unique "q3:" prefix
q3:1,3

# Q4: Restrictive+permissive AND — full Filter line unique (starts with "((owner" vs Q6 "((data")
Filter: ((owner = 'rls_exp_user'::text) AND (id > 1))

# Q5: Restrictive narrows results — unique "q5:" prefix
q5:3

# Q6: User WHERE coexists with RLS — unique triple-predicate combination
(data = 'visible'::text) AND ((owner = 'rls_exp_user'::text) AND (id > 1))
