del_restrictive|dump_test|d|f|{0}|id > 0|
ins_check|dump_test|a|t|{0}||owner_name = current_user
sel_owner|dump_test|r|t|{0}|owner_name = current_user|
upd_all|dump_test|w|t|{0}|true|owner_name = current_user

-- pg_policies view: all 4 policies with human-readable fields
