ins_check|dump_test|PERMISSIVE|INSERT|{public}||owner_name = current_user
sel_owner|dump_test|PERMISSIVE|SELECT|{public}|owner_name = current_user|
upd_all|dump_test|PERMISSIVE|UPDATE|{public}|true|owner_name = current_user

