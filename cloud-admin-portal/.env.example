# Cloud Admin Portal Configuration
# Copy this file to .env and update with your values

# TiKV PD Configuration
PD_ENDPOINTS=127.0.0.1:2379

# db9-server Server Configuration (Internal - for backend connections)
DB9_PG_HOST=127.0.0.1
DB9_PG_PORT=5433

# db9-server Public Endpoints (for end-user connections)
# Comma-separated list of host:port pairs for load balancing
# Examples:
#   Single endpoint: pg.example.com:5433
#   Multiple endpoints: pg1.example.com:5433,pg2.example.com:5433,pg3.example.com:5433
DB9_PG_PUBLIC_ENDPOINTS=127.0.0.1:5433

# API Server Configuration
DB9_API_PORT=8090

# Database Configuration
DB9_DATABASE_URL=sqlite:///backend/data/portal.db

# Session Configuration
DB9_SESSION_TTL_HOURS=1

# Debug Mode
DB9_DEBUG=false
