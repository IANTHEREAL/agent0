# pg-tikv Cloud Admin Portal - Environment Configuration
# Copy this file to .env and customize for your environment

# TiKV PD Configuration
PD_ENDPOINTS=127.0.0.1:2379

# pg-tikv Server (Internal - for backend connections)
PG_HOST=127.0.0.1
PG_PORT=5433

# pg-tikv Public Endpoints (for end-user connections)
# Comma-separated list of host:port pairs
# Example for load balancing: pg1.example.com:5433,pg2.example.com:5433
PG_PUBLIC_ENDPOINTS=pg.example.com:5433

# API Server
API_PORT=8080
