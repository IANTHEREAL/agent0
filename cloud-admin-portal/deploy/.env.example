# pg-tikv Cloud Admin Portal - Environment Configuration
# Copy this file to .env and customize for your environment

# TiKV PD Configuration
PD_ENDPOINTS=127.0.0.1:2379

# pg-tikv Server
PG_HOST=127.0.0.1
PG_PORT=5433

# Admin Authentication
# IMPORTANT: Change this in production!
ADMIN_PASSWORD=admin

# JWT Secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random secret is generated on startup (tokens won't survive restarts)
JWT_SECRET=

# API Server
API_PORT=8080
