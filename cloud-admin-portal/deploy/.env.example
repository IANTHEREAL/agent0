# db9-server Cloud Admin Portal - Environment Configuration
# Copy this file to .env and customize for your environment

# TiKV PD Configuration
PD_ENDPOINTS=localhost:2379

# db9-server Server (Internal - for backend connections)
PG_HOST=127.0.0.1
PG_PORT=5433

# db9-server Public Endpoints (for end-user connections)
PG_PUBLIC_ENDPOINTS=127.0.0.1:5433

# API Keys (comma-separated, empty = no auth)
API_KEYS=

# Database URL (sqlite:// or postgres://)
DATABASE_URL=sqlite://data/portal.db?mode=rwc

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:5173

# Nginx port
NGINX_PORT=80

# Log level
RUST_LOG=info
