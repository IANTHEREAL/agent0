#
# --- E2E dev-only tests (NOT in regression gate) ---
# Timing-sensitive (sleep/GC tick), large data, or special infra.
# Run manually against dev environment:
#
# Basic e2e (std db9+TiKV, ~15-35s each):
#   python3 tests/safety_gc_safepoint.py --dsn ...
#   python3 tests/safety_hnsw_s3_offload.py --dsn ...
#   python3 tests/safety_copy_rotation.py --dsn ...
#   python3 tests/2053_hnsw_concurrent_search.py --dsn ...
#
# Stress/boundary (large data, concurrent, ~30-120s each):
#   python3 tests/stress_boundary_test.py --dsn ...
#   python3 tests/stress_boundary_test_2.py --dsn ...
#
# GC safepoint (requires DB9_GC_SAFEPOINT_INTERVAL_SEC=30, ~90-120s):
#   python3 tests/stress_gc_critical.py --dsn ...
#   python3 tests/stress_gc_and_kvsize.py --dsn ...
#
# S3 HNSW (requires HNSW_S3_BUCKET + S3/MinIO, ~60s):
#   python3 tests/stress_hnsw_s3_live.py --dsn ...
#   HNSW_S3_TEST=1 python3 tests/safety_hnsw_s3_offload.py --dsn ...
# #2345 – schema cache LRU eviction (unit test: schema_deser_cache_prevents_reparse)
# No SQL regression test — internal cache behavior, not observable via SQL.
# Regression coverage: unit-tests job (cargo test schema_deser_cache_prevents_reparse,
# jwks_rejects_oversized_key_set, evict_user_tsc_keyspace_removes_all_entries)
