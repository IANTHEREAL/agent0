# PostgreSQL Database Connection
DATABASE_URL=postgresql://admin:admin@127.0.0.1:5433/postgres

# OpenAI API Key (required for generating embeddings)
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI Embedding Model (optional, defaults to text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions (optional, defaults to 1536)
# EMBEDDING_DIM=1536
